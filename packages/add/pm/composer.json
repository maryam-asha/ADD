{
    "name": "add/pm",
    "description": "Project management for Laravel: projects with their members, tasks and the work around them, exposed as a JSON API the host mounts.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/validation": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Add\\Pm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Add\\Pm\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Add\\Pm\\PmServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
