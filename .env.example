APP_NAME="ADD OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# AddDashboard (Vite, pinx-vue) runs on 5173 by default — must be listed
# explicitly for Sanctum's stateful-SPA cookie auth and CORS to work.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the dashboard is served from, for links this API mails out (the Fortify
# password reset). Defaults to the first CORS_ALLOWED_ORIGINS entry, so set it
# only when the dashboard does not live at that origin.
# FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=add_os
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# "mock" logs the OTP code instead of sending it; "hala_sender" sends it over
# WhatsApp via Hala Sender — see app/Services/Otp for the swappable driver.
OTP_DRIVER=mock
HALA_SENDER_API_KEY=
# Required — the linked WhatsApp device ID from the Hala Sender dashboard.
HALA_SENDER_DEVICE_ID=
SP_TODAY_KEY=
# Falls back to the real sp-today base URL in config/services.php when
# unset. Leave this line absent/commented, never set it to an empty
# string — env('SPTODAY_BASE_URL', $default) only applies $default when
# the key is missing, not when it's present-but-empty.
# SPTODAY_BASE_URL=

# Local/dev only: uncomment to make every OTP code a fixed value instead of
# random, so you don't have to read it out of the log each time. Leave unset
# anywhere real users can reach.
# OTP_FIXED_CODE=123456

# Path to the Firebase service-account JSON (relative to the project root),
# used to send push notifications via kreait/laravel-firebase. Download it
# from the Firebase console and place it under storage/app/firebase/ —
# that directory is gitignored.
FIREBASE_CREDENTIALS=

VITE_APP_NAME="${APP_NAME}"

TTLOCK_BASE_URL=
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD=

# Paymera eGate (card payments). Test gateway by default; production is
# https://egate.paymera.cc with keys issued from fmp.paymera.cc, and those
# keys are bound to this server's public IP — see docs/paymera.md.
PAYMERA_BASE_URL=https://egate-t.paymera.cc
PAYMERA_API_KEY=
PAYMERA_TERMINAL_ID=
PAYMERA_DEFAULT_LANG=en
PAYMERA_TIMEOUT=15
PAYMERA_PENDING_EXPIRY_MINUTES=60
PAYMERA_SAVED_CARDS_ENABLED=false
# The charged currency and its minor-unit exponent: Paymera takes a whole
# number, so the charge is amount x 10^exponent.
PAYMERA_CURRENCY=SYP
PAYMERA_CURRENCY_EXPONENT=2

# How long a booking or registration made with a gateway (prepaid method) is
# held for the card to go through or the member to choose another method.
PAYMENTS_PREPAYMENT_WINDOW_MINUTES=15
