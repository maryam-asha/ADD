{
  "info": {
    "_postman_id": "a1d0c0de-0001-4a1b-9c1e-add0scollection",
    "name": "ADD OS — Identity & Content",
    "description": "Member app auth (phone + WhatsApp OTP, Sanctum token), Ops dashboard auth (Fortify session + 2FA, Sanctum SPA), admin-managed site content (Founders/Partners/Community), and the public read-only feed of that same content.\n\nImport the companion environment (ADD OS - Local) and select it — base_url, admin_email, admin_password, member_phone all live there.\n\nEverything under /api lives under /api/v1 — the whole API is versioned from day one.\n\nBefore using Admin/*: run the app locally with `php artisan serve --port=8000` — Sanctum's stateful-domain check only recognizes 127.0.0.1:8000 by default.\n\nMember flow: Member/Auth/Request OTP → read the code from storage/logs/laravel.log (mock WhatsApp driver) → Member/Auth/Verify OTP — the token is captured automatically into {{member_token}}.\n\nAdmin flow: Admin/Auth/Get CSRF Cookie once, then Admin/Auth/Login — every other Admin/* request reads the XSRF token from the cookie jar automatically. Each Admin/Content/* \"Create\" request captures the new row's id into a variable ({{founder_id}}, {{partner_id}}, {{community_member_id}}) so the Get/Update/Delete requests right below it work with no manual editing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "member_token", "value": "", "type": "string" },
    { "key": "founder_id", "value": "", "type": "string" },
    { "key": "partner_id", "value": "", "type": "string" },
    { "key": "community_member_id", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Member (App)",
      "description": "Phone + OTP over WhatsApp (mock driver for now) → Sanctum bearer token.",
      "item": [
        {
          "name": "Auth",
          "description": "The login lifecycle: request a code, verify it, log out.",
          "item": [
            {
              "name": "Request OTP",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"{{member_phone}}\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/auth/otp/request",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "auth", "otp", "request"]
                },
                "description": "Rate-limited (1 per cooldown window per phone, plus a 10/min per-IP throttle). Code is dispatched via the mock WhatsApp driver — check storage/logs/laravel.log for the value until a real gateway is wired up."
              }
            },
            {
              "name": "Verify OTP",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    const token = pm.response.json().token;",
                      "    pm.collectionVariables.set('member_token', token);",
                      "    console.log('member_token captured');",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"{{member_phone}}\",\n  \"code\": \"REPLACE_WITH_CODE_FROM_LOG\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/auth/otp/verify",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "auth", "otp", "verify"]
                },
                "description": "On success: creates the user on first verification (assigns the 'member' role) and returns a Sanctum token, captured into {{member_token}}."
              }
            },
            {
              "name": "Logout",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{member_token}}" }]
                },
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/auth/logout",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "auth", "logout"]
                },
                "description": "Revokes the current access token. Calling Account/Get Me again afterwards should return 401."
              }
            }
          ]
        },
        {
          "name": "Account",
          "description": "Anything about the already-authenticated member, as opposed to the act of logging in.",
          "item": [
            {
              "name": "Get Me",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{member_token}}" }]
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/auth/me",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "auth", "me"]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin (Dashboard)",
      "description": "Fortify (session + 2FA) + Sanctum SPA. Public registration is disabled on purpose — accounts are created by an existing admin (see database/seeders/AdminUserSeeder.php for the first one).",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const xsrf = pm.cookies.get('XSRF-TOKEN');",
              "if (xsrf) {",
              "    pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: decodeURIComponent(xsrf) });",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Auth",
          "description": "The login lifecycle: CSRF cookie, login (with optional 2FA challenge), log out.",
          "item": [
            {
              "name": "Get CSRF Cookie",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/sanctum/csrf-cookie",
                  "host": ["{{base_url}}"],
                  "path": ["sanctum", "csrf-cookie"]
                },
                "description": "Run this first — sets the XSRF-TOKEN cookie that every other request in Admin/* reads automatically."
              }
            },
            {
              "name": "Login",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/login",
                  "host": ["{{base_url}}"],
                  "path": ["login"]
                },
                "description": "Returns {\"two_factor\": false} and logs the session in directly if 2FA isn't confirmed yet, or {\"two_factor\": true} and expects Two-Factor Challenge next."
              }
            },
            {
              "name": "Two-Factor Challenge",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"code\": \"123456\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/two-factor-challenge",
                  "host": ["{{base_url}}"],
                  "path": ["two-factor-challenge"]
                },
                "description": "Only needed if Login responded with two_factor: true. Use {\"recovery_code\": \"...\"} instead of \"code\" to fall back to a recovery code."
              }
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/logout",
                  "host": ["{{base_url}}"],
                  "path": ["logout"]
                }
              }
            }
          ]
        },
        {
          "name": "Account",
          "description": "Anything about the already-authenticated admin/staff user.",
          "item": [
            {
              "name": "Get Me",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/admin/me",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "admin", "me"]
                },
                "description": "Guarded by role:admin|staff — a logged-in member-only account gets 403 here, not 401."
              }
